# example/justfile

set shell := ["sh", "-c"]
set windows-shell := ["powershell.exe", "-NoProfile", "-Command"]

# Chaining operator
# and := if os() == "windows" { ";" } else { "&&" }

# Get dependencies
get:
    flutter pub get
# Run the app
run:
    flutter run
# Run integration tests
test-integration:
    flutter test integration_test/simple_test.dart
# Run on Chrome with WebAssembly and the cross-origin isolation the wasm needs
run-web:
    flutter run -d chrome --wasm \
      --web-header=Cross-Origin-Opener-Policy=same-origin \
      --web-header=Cross-Origin-Embedder-Policy=require-corp
# Build the web app with WebAssembly (no browser needed; serve the output
# with Cross-Origin-Opener-Policy: same-origin and
# Cross-Origin-Embedder-Policy: require-corp)
build-web:
    flutter build web --wasm
# Build android
build-android:
    flutter build apk --release
# Clean example project
clean:
    flutter clean
# Fix Dart code
fix:
    dart fix --apply
# Format Dart code
fmt:
    dart format lib example rust_builder bin
# fix and format
prep:
    fix fmt
